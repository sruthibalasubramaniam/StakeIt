# =============================================================================
# Stake It — deployment environment (used by docker compose)
#
#   cp .env.example .env      # fill in the blank values, then:
#   docker compose build && docker compose up -d
#
# This file is read by docker-compose.yml and docker-compose.dev.yml only.
# For native `npm run dev` use backend/.env and frontend/.env instead.
#
# NEVER commit a filled-in copy. .env is gitignored; only this template ships.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL (managed; no database container runs here)
# -----------------------------------------------------------------------------
# Direct connection string (Supabase → Settings → Database → URI):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Pooled/ Supavisor string (recommended for production):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Auth is local only: bcrypt password hashes, HS256 JWTs signed with JWT_SECRET.
# Supabase Auth is no longer used (its token verifier had been removed, so a
# Supabase-issued token could sign in but never authenticate a request).
# REQUIRED in production: the API refuses to boot with the development
# placeholder or a secret shorter than 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Supabase is still used for PostgreSQL and private file storage — server-side
# only. Never expose these to the browser.
SUPABASE_URL=
# Bypasses Row Level Security: server-only, never logged, never shipped.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Reading lessons — private PDF storage (Supabase Storage)
# -----------------------------------------------------------------------------
# Bucket holding instructor-uploaded reading PDFs. Create it as a PRIVATE
# bucket with no public read policy: the API uploads with the service-role key
# and gives the browser a short-lived signed URL. PDF upload returns 503 with
# reason STORAGE_NOT_CONFIGURED when these are blank — written sections and
# external links keep working.
SUPABASE_STORAGE_BUCKET=course-assets
# Largest accepted PDF, in MB. Drives both the request-body limit and the
# service-side check, so they can never disagree.
READING_PDF_MAX_MB=10
# Lifetime of a signed PDF URL, in seconds (60–86400).
READING_SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Optional AI helpers (reading summaries + knowledge-check drafts)
# -----------------------------------------------------------------------------
# Leave AI_API_KEY empty to disable AI entirely: the product works without it and
# the AI endpoints answer 503 AI_UNAVAILABLE. Every provider is called through
# its OpenAI-compatible /chat/completions route, so only the base URL differs.
#   openai     → https://api.openai.com/v1                        (gpt-4o-mini)
#   gemini     → https://generativelanguage.googleapis.com/v1beta/openai
#   anthropic  → https://api.anthropic.com/v1
#   compatible → set AI_BASE_URL yourself (Groq, OpenRouter, Ollama, vLLM…)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=3000
AI_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------
# Off unless EMAIL_ENABLED=true AND a key AND a from-address are present, so a
# half-configured environment never sends. EMAIL_FROM must be on a domain
# verified in Resend — a resend.dev sender can only reach your own inbox.
EMAIL_ENABLED=false
# resend = HTTP API, needs a verified domain (gmail.com can never be verified).
# smtp   = send through a real mailbox, which is the only way to send FROM a
#          Gmail address: the mailbox authenticates the sender.
EMAIL_PROVIDER=resend
# --- smtp only (Gmail example) -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail App Password (16 chars), NOT the account password.
SMTP_PASS=
# --- resend only -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Stake It <notifications@yourdomain.com>"
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=15000
# Public origin used in email links.
APP_URL=http://localhost:5173

# Name printed on certificates as the issuing body.
CERTIFICATE_ISSUER="Stake It Academy"

# -----------------------------------------------------------------------------
# API runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (nginx in compose = 1).
TRUST_PROXY=1
# Allowed browser origins. Must be explicit in production — "*" is rejected.
# Add the origin users actually visit, e.g. https://stake-it.example.com
CORS_ORIGIN=http://localhost:8080

# Host port mappings.
API_PORT=4000
WEB_PORT=8080

# -----------------------------------------------------------------------------
# Frontend build (inlined into the bundle at build time — PUBLIC values only)
# -----------------------------------------------------------------------------
# Leave as `/api` so nginx serves the API on the same origin (no CORS needed).
# Use an absolute URL only when the API lives on a different origin, and add that
# origin to CORS_ORIGIN above.
VITE_API_URL=/api
VITE_APP_NAME=Stake It
# Demo account shortcut buttons on the sign-in screen. Set false in production.
VITE_ENABLE_DEMO_LOGIN=true

# -----------------------------------------------------------------------------
# Platform economics — virtual points only
# -----------------------------------------------------------------------------
SIGNUP_WALLET_GRANT=1500
AT_RISK_THRESHOLD_PERCENT=15

# -----------------------------------------------------------------------------
# Self-hosted PostgreSQL (docker-compose.dev.yml only — ignored by the managed
# stack above, which uses Supabase)
# -----------------------------------------------------------------------------
POSTGRES_USER=stakeit
POSTGRES_PASSWORD=stakeit_dev_password
POSTGRES_DB=stakeit
# Host port 5433 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
# Host ports for the DEV stack only. They are separate variables from the
# API_PORT / WEB_PORT above so the two stacks can run at the same time: the
# production stack keeps :8080/:4000, the dev stack takes :8090/:4100.
DEV_API_PORT=4100
DEV_WEB_PORT=8090
