# =============================================================================
# Stake It API — environment template
#
#   cp backend/.env.example backend/.env    # then fill in real values
#
# EVERY variable in this file is SERVER-ONLY. Nothing here may be exposed to the
# browser bundle: these values include the database password and, when Supabase
# is enabled, the service-role key. Only `frontend/.env` (VITE_* only) is public.
#
# .env is gitignored. Never commit a filled-in copy.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# debug | info | warn | error
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (docker/nginx = 1, direct = 0).
# Affects the client IP used by rate limiting.
TRUST_PROXY=1
# Comma-separated list of allowed browser origins. Never "*" in production —
# the API refuses to start with a wildcard when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL via Prisma
# -----------------------------------------------------------------------------
# Two supported shapes:
#
#  (a) DIRECT connection (simplest; what this project ships with)
#      Supabase → Settings → Database → Connection string → URI
#      postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#      NOTE: Supabase direct connections are IPv6-only on many plans. If your
#      host has no IPv6 route, use the pooled string below instead.
#
#  (b) POOLED (Supavisor) — recommended for the API in production
#      postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#      Then run migrations against the DIRECT url:
#        DATABASE_URL="postgresql://...:5432/postgres" npx prisma migrate deploy
#      (Optionally uncomment `directUrl = env("DIRECT_URL")` in
#       prisma/schema.prisma and set DIRECT_URL to make this automatic.)
DATABASE_URL=

# Optional: used by the integration suite so tests never touch the app database.
# Falls back to DATABASE_URL when unset.
TEST_DATABASE_URL=

# Optional: only consulted if `directUrl` is uncommented in prisma/schema.prisma.
# DIRECT_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# local    → email + password (bcrypt) with HS256 JWTs issued by this API.
#            Works offline; use it for local development and the Docker dev stack.
# supabase → credentials handled by Supabase Auth (GoTrue); the API verifies the
#            issued access tokens and maps them to local profiles.
AUTH_PROVIDER=local

# Required when AUTH_PROVIDER=local.
# Production rules enforced at boot: must not be the development placeholder and
# must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_MIN_LENGTH=8

# Required when AUTH_PROVIDER=supabase (SUPABASE_URL + at least one of the two
# keys below). Supabase → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses Row Level Security. Never ship to the browser and
# never log it. Only needed for administrative Supabase operations.
SUPABASE_SERVICE_ROLE_KEY=
# Only required if the project signs JWTs with a shared secret (HS256). Projects
# using asymmetric signing keys are verified against the project JWKS instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Storage bucket for course assets (optional).
SUPABASE_STORAGE_BUCKET=course-assets

# -----------------------------------------------------------------------------
# Platform economics — virtual points only, no real money
# -----------------------------------------------------------------------------
# Welcome grant credited to every new wallet.
SIGNUP_WALLET_GRANT=1500

# -----------------------------------------------------------------------------
# Engines & scheduled jobs
# -----------------------------------------------------------------------------
# Attempts settled per deadline-engine pass.
DEADLINE_JOB_BATCH_SIZE=200
# Enables deadline reminders alongside settlement.
NOTIFICATION_JOB_ENABLED=true
# Percentage-point gap between expected and actual progress that flags AT_RISK.
AT_RISK_THRESHOLD_PERCENT=15
# false disables the in-process cron scheduler (the test suite sets this).
SCHEDULER_ENABLED=true

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Developer diagnostics (never enable in production)
# -----------------------------------------------------------------------------
# Logs every SQL statement Prisma executes — useful for N+1 auditing. Ignored
# when NODE_ENV=production.
PRISMA_LOG_QUERIES=false
