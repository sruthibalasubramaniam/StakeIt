# =============================================================================
# Stake It web client — environment template
#
#   cp frontend/.env.example frontend/.env
#
# ONLY VITE_-prefixed variables reach the browser bundle, and everything that
# does is PUBLIC. Never put a secret here — no service-role keys, no database
# URLs, no JWT secrets. Those live in backend/.env, which is server-only.
#
# Vite inlines these values at BUILD time. When running the production image,
# change them with Docker build args (see frontend/Dockerfile), not at runtime.
# =============================================================================

# Base URL the browser uses to reach the API.
#
#  - Local development (vite dev server, API on 4000):
#        http://localhost:4000/api
#  - Docker / reverse proxy: use a same-origin path so nginx forwards it:
#        /api
#    With `/api` the browser only ever talks to one origin, so no CORS entry is
#    needed. This is the default in docker-compose.yml.
#
# This must be an address the BROWSER can resolve. A docker-internal hostname
# such as `http://api:4000` will not work — the container name is not resolvable
# from the user's machine.
VITE_API_URL=http://localhost:4000/api

VITE_APP_NAME=Stake It

# Demo accounts on the sign-in screen.
#
# REMOVED. The sign-in screen no longer advertises seeded credentials or the
# shared demo password — that was a credential disclosure on a public page.
# Seeded accounts (learner@stakeit.demo, instructor@stakeit.demo,
# admin@stakeit.demo) still exist after `npm run db:seed`; sign in with the
# password from the seed script. Keep this out of the bundle entirely.

# Only used by the Vite dev-server proxy; irrelevant to production builds.
VITE_PROXY_TARGET=http://localhost:4000
